rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function rootEmail() {
      return signedIn() && request.auth.token.email in [
        '6cee932f6a2e32baf138fd77429565df5ac34fdefddd6f3dbb0804a23c94fdfe@accounts.invalid',
        '563b7df548c46e765b517d4db8ef94f17570d00a38206931ec11085e52e620cc@accounts.invalid'
      ];
    }
    function active() { return signedIn() && profile().status == 'active'; }
    function root() {
      return active() && profile().role == 'super_admin' && rootEmail();
    }
    function admin() {
      return root() || (active() && profile().role == 'admin' &&
        profile().createdBy != profile().approvedBy &&
        get(/databases/$(database)/documents/users/$(profile().createdBy)).data.role == 'super_admin' &&
        get(/databases/$(database)/documents/users/$(profile().approvedBy)).data.role == 'super_admin');
    }
    function student() { return active() && profile().role == 'user'; }
    function examData(examId) {
      return get(/databases/$(database)/documents/exams/$(examId)).data;
    }
    function examAvailable(examId) {
      let exam = examData(examId);
      return exam.isOpen == true &&
        (!('closesAt' in exam) || exam.closesAt == null || request.time < exam.closesAt);
    }
    function validStudentAttemptCreate() {
      let attempt = request.resource.data;
      let exam = examData(attempt.examId);
      return attempt.keys().hasOnly([
          'userId', 'examId', 'startedAt', 'endsAt', 'status', 'attemptCount',
          'selectedAnswers', 'currentQuestionIndex'
        ]) &&
        attempt.keys().hasAll([
          'userId', 'examId', 'startedAt', 'endsAt', 'status', 'attemptCount'
        ]) &&
        attempt.userId == request.auth.uid &&
        attempt.examId is string && examAvailable(attempt.examId) &&
        exam.durationMinutes is int && exam.durationMinutes > 0 &&
        attempt.status == 'in_progress' && attempt.attemptCount == 0 &&
        attempt.startedAt == request.time && attempt.endsAt is timestamp &&
        attempt.endsAt > request.time &&
        attempt.endsAt <= request.time + duration.value(exam.durationMinutes, 'm') &&
        (!('closesAt' in exam) || exam.closesAt == null || attempt.endsAt <= exam.closesAt);
    }
    function validCompletedAttempt(attempt, old) {
      return attempt.keys().hasAll([
          'bestScore', 'diemSo', 'correctAnswers', 'totalQuestions',
          'attemptCount', 'status'
        ]) && attempt.status == 'completed' &&
        attempt.attemptCount == old.attemptCount + 1 &&
        attempt.diemSo is number && attempt.diemSo >= 0 && attempt.diemSo <= 10 &&
        attempt.bestScore is number && attempt.bestScore >= 0 && attempt.bestScore <= 10 &&
        attempt.correctAnswers is int && attempt.totalQuestions is int &&
        attempt.correctAnswers >= 0 && attempt.totalQuestions > 0 &&
        attempt.correctAnswers <= attempt.totalQuestions;
    }
    function validStudentAttemptUpdate() {
      let attempt = request.resource.data;
      let old = resource.data;
      let exam = examData(old.examId);
      return old.userId == request.auth.uid &&
        attempt.userId == old.userId && attempt.examId == old.examId &&
        attempt.diff(old).affectedKeys().hasOnly([
          'status', 'attemptCount', 'bestScore', 'diemSo', 'bestCorrectAnswers',
          'correctAnswers', 'totalQuestions', 'bestCompletedAt', 'completedAt',
          'lastAttemptAt', 'bestAnswers', 'answers', 'selectedAnswers',
          'currentQuestionIndex', 'lastSavedAt', 'startedAt', 'endsAt', 'examTitle'
        ]) &&
        (((old.status == 'in_progress' && attempt.status == 'in_progress' &&
          request.time <= old.endsAt + duration.value(1, 'm') &&
          attempt.attemptCount == old.attemptCount) ||
         (old.status == 'completed' && attempt.status == 'in_progress' &&
          examAvailable(old.examId) && exam.durationMinutes is int &&
          attempt.startedAt == request.time && attempt.endsAt > request.time &&
          attempt.endsAt <= request.time + duration.value(exam.durationMinutes, 'm') &&
          (!('closesAt' in exam) || exam.closesAt == null || attempt.endsAt <= exam.closesAt) &&
          attempt.attemptCount == old.attemptCount &&
          (!('maxAttempts' in exam) || exam.maxAttempts == null ||
            attempt.attemptCount < exam.maxAttempts))) ||
         (old.status == 'in_progress' &&
          request.time <= old.endsAt + duration.value(1, 'm') &&
          validCompletedAttempt(attempt, old)));
    }

    match /users/{id} {
      allow get: if (signedIn() && request.auth.uid == id &&
        resource.data.status == 'active') || admin();
      allow list: if admin();
      allow create: if admin() && request.resource.data.createdBy == request.auth.uid &&
        ((request.resource.data.role == 'user' && request.resource.data.status == 'active') ||
         (root() && request.resource.data.role == 'admin' && request.resource.data.status == 'pending'));
      allow create: if signedIn() && id == request.auth.uid && rootEmail() &&
        request.resource.data.role == 'super_admin' && request.resource.data.status == 'active';
      allow update: if admin() && resource.data.role != 'super_admin' &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.createdBy == resource.data.createdBy &&
        (root() || (resource.data.role == 'user' && resource.data.createdBy == request.auth.uid));
      allow delete: if admin() && resource.data.role != 'super_admin' &&
        (root() || (resource.data.role == 'user' &&
          resource.data.createdBy == request.auth.uid));
    }
    match /admin_requests/{id} {
      allow read: if root();
      allow create: if root() && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if root() && resource.data.createdBy != request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.targetUid == resource.data.targetUid;
      allow delete: if root();
    }
    match /system/access { allow read, write: if false; }
    match /system/app_status {
      allow read: if true;
      allow create, update: if root() &&
        request.resource.data.keys().hasOnly(['maintenance', 'updatedAt', 'updatedBy']) &&
        request.resource.data.maintenance is bool &&
        request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /system/{id} { allow read, write: if false; }
    match /usernames/{id} {
      allow read: if admin();
      allow create: if admin();
      allow update: if false;
      allow delete: if admin() &&
        get(/databases/$(database)/documents/users/$(resource.data.uid)).data.role != 'super_admin' &&
        (root() ||
          (get(/databases/$(database)/documents/users/$(resource.data.uid)).data.role == 'user' &&
           get(/databases/$(database)/documents/users/$(resource.data.uid)).data.createdBy == request.auth.uid));
    }
    match /account_operations/{id} { allow read, write: if false; }
    match /admin_request_secrets/{id} { allow read, write: if false; }
    match /exams/{id} {
      allow read: if admin() || student();
      allow create: if root();
      allow update, delete: if root();
      match /questions/{questionId} {
        allow read: if admin() || (student() && examAvailable(id));
        allow create: if root();
        allow update, delete: if root();
      }
    }
    match /questions/{id} {
      allow read: if admin() || student();
      allow create: if root();
      allow update, delete: if root();
    }
    match /CAU_HOI/{id} {
      allow read: if admin() || student();
      allow create: if root();
      allow update, delete: if root();
    }
    match /exam_attempts/{id} {
      allow read: if admin() || (student() && resource.data.userId == request.auth.uid);
      // Spark can enforce ownership, time, shape and score bounds. Correct grading
      // still needs a trusted backend because answer keys are used by the client.
      allow create: if root() || (student() && validStudentAttemptCreate());
      allow update: if root() || (student() && validStudentAttemptUpdate());
      allow delete: if root() ||
        (active() && profile().role == 'admin' &&
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.role == 'user' &&
          get(/databases/$(database)/documents/users/$(resource.data.userId)).data.createdBy == request.auth.uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
