          "projectId": "e09-elearning",
          "appId": "1:722108374060:android:04b94732487bc398eec589",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "e09-elearning",
          "configurations": {
            "android": "1:722108374060:android:04b94732487bc398eec589",
            "ios": "1:722108374060:ios:3ae05f6bc20ac89feec589",
