rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function active() { return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'; }
    function admin() {
      let p = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let roots = firestore.get(/databases/(default)/documents/system/access).data.rootUids;
      return active() && p.role == 'super_admin' && request.auth.uid in roots;
    }
    function image() { return request.resource != null && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    match /avatars/{uid}/{file} {
      allow read: if active();
      allow create: if active() && request.auth.uid == uid && image();
    }
    match /lessons/{course}/{file} {
      allow read: if active();
      allow create: if admin() && image();
    }
  }
}
