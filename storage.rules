rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cloud Functions mirror only the public lease metadata into the profile.
    // This keeps uploads within Storage Rules' two Firestore document limit:
    // users/{uid} for account/session status and system/access for root UIDs.
    function hasCurrentAccountSession(profile) {
      let session = profile.get('accountSession', null);
      return session is map && session.get('status', '') == 'active' &&
          session.get('authTime', -1) == request.auth.token.get('auth_time', -2) &&
          session.get('lastSeenAt', null) is timestamp &&
          session.lastSeenAt + duration.value(2, 'm') > request.time;
    }
    function active() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        hasCurrentAccountSession(firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data);
    }
    function admin() {
      let p = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let roots = firestore.get(/databases/(default)/documents/system/access).data.rootUids;
      return active() && p.role == 'super_admin' && request.auth.uid in roots;
    }
    function image() { return request.resource != null && request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    match /avatars/{uid}/{file} {
      allow read: if active();
      allow create, update: if active() && request.auth.uid == uid && image();
    }
    match /lessons/{course}/{file} {
      allow read: if active();
      allow create: if admin() && image();
    }
    match /courses/{file} {
      allow read: if active();
      allow create: if admin() && image();
    }
    match /news/{file} {
      allow read: if active();
      allow create: if admin() && image();
    }
    match /home-banners/{file} {
      allow read: if active();
      allow create: if admin() && image();
    }
  }
}
